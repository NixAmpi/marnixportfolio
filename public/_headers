# Cloudflare Pages response headers (copied into ./out by `next build`).

# The Open Graph image is exported without a file extension; label it so link
# previews (LinkedIn, Facebook, Slack) accept it.
/opengraph-image
  Content-Type: image/png

# Hashed build assets never change; cache them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
